# Leave empty to use the same-origin /v1 and /healthz proxy in both Vite and Vercel.
# Only set http://127.0.0.1:8000 when intentionally bypassing the local proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://v52-backend.onrender.com

# Public Reown Cloud project ID. Register localhost and the exact production
# domain in https://dashboard.reown.com/. This value is not a private key.
VITE_REOWN_PROJECT_ID=

# Remote Streamable HTTP endpoint for Claude/Codex MCP configuration.
# Public URL only; never put the MCP wallet key or an authorization token in VITE_*.
VITE_MCP_SERVER_URL=https://v52-mcp-production.up.railway.app/mcp
